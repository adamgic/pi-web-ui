{
  "name": "pi-web-ui",
  "version": "0.1.0",
  "description": "A browser interface for the active Pi coding-agent session",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "web-ui"
  ],
  "files": [
    "src",
    "public",
    "start.mjs",
    "start.sh",
    "README.md",
    "LICENSE",
    "scripts/setup-pty.mjs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "start": "node start.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "postinstall": "node scripts/setup-pty.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
